.DS_Store
.work/
*.crdownload
__pycache__/
*.pyc
node_modules/
.venv/

# Pack folders: only the spec and the pictures it names are shared here. Everything else a
# pack produces (artifacts, the intake, the input inventory and its extracts of customer
# documents, sources, research notes, the decisions log) lives in the local work folder,
# $ORACLE_PACKS_OUT/<slug>/ (default ~/oracle-packs/<slug>/), and never enters this repo:
# those files quote the customer's own documents and carry internal figures (2026-09-24).
# The architecture model is built from the spec by every renderer and never stored.
packs/*/*
!packs/*/pack-spec.yaml
!packs/*/pack-spec.md
!packs/*/visuals/
