#!/usr/bin/env bash
# py — run the oracle-packs Python tools with an interpreter that has their packages, on any machine.
#
#   shared/tools/py <tool.py> [args...]   exec the resolved interpreter with exactly these arguments
#   shared/tools/py --which               print the interpreter that would run them (exit 0, or 2)
#   shared/tools/py --check               the interpreter and one line per package (exit 0 when all import)
#
# The tools need PyYAML, python-docx, python-pptx, Pillow and pypdf on Python 3.9 or newer. This
# script takes the first interpreter that imports all five, in this order, and execs it:
#
#   1. $ORACLE_PACKS_PY, when set and it imports them. Set but broken: one line on stderr, then on.
#   2. <root>/.venv/bin/python, <root> being two levels above this file: the repo root in a source
#      checkout, the plugin root in an installed plugin.
#   3. the managed venv, $ORACLE_PACKS_VENV or else $HOME/.oracle-packs/venv. When it is missing it
#      is created with `python3 -m venv` and `pip install -q -r <requirements>` — <root>/requirements.txt
#      when there is one, else the requirements.txt beside this file — with one line on stderr saying
#      so and where. A provisioning run that was cut short is resumed on the next call.
#   4. plain python3, when it already imports them.
#
# When nothing works it exits 2 with one line saying what to run, never a traceback.
#
# Needs bash (3.2 or newer) and python3, nothing else. On Windows it runs under Git Bash or WSL; a
# venv's Scripts/python.exe is found as well as bin/python.

PROBE='import sys
if sys.version_info < (3, 9):
    sys.exit(1)
import yaml, docx, pptx, PIL, pypdf'
PACKAGES="PyYAML, python-docx, python-pptx, Pillow and pypdf"

say() { printf 'oracle-packs: %s\n' "$*" >&2; }

# This file's real directory, with shell builtins only (a symlinked copy is followed to the file).
src="${BASH_SOURCE[0]:-$0}"
while [ -L "$src" ]; do
  link="$(readlink "$src")" || break
  case "$link" in
    /*) src="$link" ;;
    *) case "$src" in */*) src="${src%/*}/$link" ;; *) src="$link" ;; esac ;;
  esac
done
case "$src" in */*) here="${src%/*}" ;; *) here="." ;; esac
here="$(cd "$here" && pwd -P)" || { say "cannot locate $src"; exit 2; }
root="$(cd "$here/../.." && pwd -P)" || { say "cannot locate the root above $here"; exit 2; }

if [ -f "$root/requirements.txt" ]; then REQ="$root/requirements.txt"; else REQ="$here/requirements.txt"; fi

if [ -n "${ORACLE_PACKS_VENV:-}" ]; then
  VENV="$ORACLE_PACKS_VENV"; VENV_SHOWN="$VENV"
elif [ -n "${HOME:-}" ]; then
  VENV="$HOME/.oracle-packs/venv"; VENV_SHOWN="~/.oracle-packs/venv"
else
  VENV=""; VENV_SHOWN="~/.oracle-packs/venv"
fi

# the interpreter inside a venv folder, POSIX or Windows layout
venv_py() {
  if [ -x "$1/bin/python" ]; then printf '%s\n' "$1/bin/python"
  elif [ -x "$1/Scripts/python.exe" ]; then printf '%s\n' "$1/Scripts/python.exe"
  else return 1
  fi
}

# does this interpreter import all five packages on Python 3.9+?
imports() { [ -n "$1" ] && "$1" -c "$PROBE" >/dev/null 2>&1; }

# a Python 3.9+ to build a venv with: python3, else python (Git Bash often has only the latter)
base_python() {
  for name in python3 python; do
    cand="$(command -v "$name" 2>/dev/null)" || continue
    "$cand" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' >/dev/null 2>&1 \
      && { printf '%s\n' "$cand"; return 0; }
  done
  return 1
}

last_line() { printf '%s\n' "$1" | awk 'NF { l = $0 } END { print l }'; }

# create (or finish creating) the managed venv; one line on stderr, the cause on failure
provision() {
  base="$(base_python)" || return 1
  if [ ! -f "$REQ" ]; then say "cannot provision $VENV: no requirements file at $REQ"; return 1; fi
  say "provisioning the Python environment in $VENV from $REQ (one time, about a minute)"
  err="$("$base" -c 'import os, sys
os.makedirs(sys.argv[1], exist_ok=True)
open(os.path.join(sys.argv[1], ".provisioning"), "w").close()' "$VENV" 2>&1)" \
    || { say "could not provision $VENV: $(last_line "$err")"; return 1; }
  err="$("$base" -m venv "$VENV" 2>&1 >/dev/null)" \
    || { say "could not provision $VENV: $(last_line "$err")"; return 1; }
  vpy="$(venv_py "$VENV")" || { say "could not provision $VENV: the venv has no interpreter"; return 1; }
  err="$("$vpy" -m pip install -q --disable-pip-version-check -r "$REQ" 2>&1 >/dev/null)" \
    || { say "could not provision $VENV: $(last_line "$err")"; return 1; }
  rm -f "$VENV/.provisioning"
}

# sets PY to the first interpreter that imports the packages; returns 1 when there is none
resolve() {
  if [ -n "${ORACLE_PACKS_PY:-}" ]; then
    if [ "$ORACLE_PACKS_PY" -ef "$src" ]; then
      say "ORACLE_PACKS_PY points at this resolver itself; ignoring it"
    elif imports "$ORACLE_PACKS_PY"; then
      PY="$ORACLE_PACKS_PY"; return 0
    else
      say "ORACLE_PACKS_PY=$ORACLE_PACKS_PY does not import $PACKAGES on Python 3.9+; looking further"
    fi
  fi

  if PY="$(venv_py "$root/.venv")" && imports "$PY"; then return 0; fi

  if [ -n "$VENV" ]; then
    PY="$(venv_py "$VENV")"
    if [ -n "$PY" ] && [ ! -e "$VENV/.provisioning" ] && imports "$PY"; then return 0; fi
    if [ -z "$PY" ] || [ -e "$VENV/.provisioning" ]; then
      if provision && PY="$(venv_py "$VENV")" && imports "$PY"; then return 0; fi
    fi
  fi

  if PY="$(command -v python3 2>/dev/null)" && imports "$PY"; then return 0; fi
  PY=""
  return 1
}

fail() {
  say "no Python 3.9+ with $PACKAGES — run: python3 -m venv $VENV_SHOWN && $VENV_SHOWN/bin/pip install -r $REQ"
  exit 2
}

# the interpreter, then one line per package; exit 0 when all five import
report() {
  "$1" - <<'PYCHECK'
import importlib, sys
try:
    from importlib.metadata import version
except ImportError:                         # Python < 3.8
    version = None
print("interpreter: %s (Python %s)" % (sys.executable, sys.version.split()[0]))
missing = 0
if sys.version_info < (3, 9):
    missing += 1
    print("  %-13s too old: the tools need 3.9 or newer" % "Python")
for module, dist in (("yaml", "PyYAML"), ("docx", "python-docx"), ("pptx", "python-pptx"),
                     ("PIL", "Pillow"), ("pypdf", "pypdf")):
    try:
        importlib.import_module(module)
    except Exception as exc:                # noqa: BLE001 - any import failure is "missing"
        missing += 1
        print("  %-13s MISSING (%s)" % (dist, exc.__class__.__name__))
        continue
    try:
        found = version(dist) if version else "?"
    except Exception:                       # noqa: BLE001
        found = "?"
    print("  %-13s ok %s" % (dist, found))
sys.exit(1 if missing else 0)
PYCHECK
}

case "${1:-}" in
  --which)
    resolve || fail
    printf '%s\n' "$PY"
    exit 0
    ;;
  --check)
    if resolve; then report "$PY"; exit $?; fi
    if near="$(base_python)"; then report "$near"; fi
    fail
    ;;
esac

resolve || fail
exec "$PY" "$@"
